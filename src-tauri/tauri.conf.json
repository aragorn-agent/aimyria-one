{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AimyriA go",
  "version": "1.0.2",
  "identifier": "com.aimyria.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm run dev:renderer",
    "beforeBuildCommand": "pnpm run build:renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AimyriA go",
        "titleBarStyle": "Overlay",
        "width": 880,
        "height": 620,
        "minWidth": 720,
        "minHeight": 520,
        "visible": false,
        "skipTaskbar": true,
        "resizable": true,        "fullscreen": false,
        "center": true,
        "visibleOnAllWorkspaces": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "shortDescription": "把 AI 编程命令行一键指向 Aimyria",
    "longDescription": "AimyriA go 常驻系统托盘，把 [CC]、Codex、Gemini CLI、OpenCode、OpenClaw 一键配置为使用 Aimyria 中转，并在余额不足时提醒。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "resources": [
      "WebView2Loader.dll"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "aimyria",
          "ccswitch"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM4MDI4QzlBNTczOTI4RTMKUldUaktEbFhtb3dDeUM5US9kT0FmdGR5Ti9vQzcwa2dTMlpibDVDUmQ2M0VGTzVOWnd0SGpFVlEK",
      "endpoints": [
        "https://api.aimyria.com/updates/latest.json"
      ]
    }
  }
}
